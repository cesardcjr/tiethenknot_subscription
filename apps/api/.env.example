# Use the Supabase Postgres connection string. Keep staging and production separate.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-long-random-staging-secret
PORT=5000

# Render places the application behind one trusted proxy hop.
TRUST_PROXY_HOPS=1

# Comma-separated allowed browser origins. Use exact origins; do not include paths.
ALLOWED_ORIGINS=https://YOUR-STAGING-PLANNER.vercel.app,https://YOUR-STAGING-INVITATION-STUDIO.vercel.app

# Optional: trust the generated Vercel preview domains for this staging service only.
ALLOWED_ORIGIN_PATTERNS=https://tietheknot-mern-front-*.vercel.app
